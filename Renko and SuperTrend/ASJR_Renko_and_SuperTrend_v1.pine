//@version=6
// ASJR Renko and SuperTrend v1
// Original close-confirmed Renko emulator. Bricks are time-aligned to their source bar.
// Not Dr Devendra's proprietary script and not a tick-accurate/native Renko chart.
// Default traditional fixed price-unit box size = 8.33, matching the requested UI.
indicator("ASJR Renko and SuperTrend v1", shorttitle="ASJR Renko ST v1", overlay=true, behind_chart=false, max_boxes_count=500)

const string G_RENKO = "01 - RENKO BRICK ENGINE"
const string G_TREND = "02 - RENKO SUPERTREND"
const string G_VIEW = "03 - DISPLAY AND COLOURS"
const string G_INFO = "04 - STATUS"

string sizeMode = input.string("Traditional", "Box size assignment method", options=["Traditional", "ATR", "Percentage"], group=G_RENKO)
int atrPeriod = input.int(14, "Source ATR period", minval=1, group=G_RENKO)
float atrFactor = input.float(0.50, "ATR multiplier", minval=0.01, step=0.05, group=G_RENKO)
float fixedSize = input.float(8.33, "Box size (Traditional)", minval=0.000001, step=0.01, group=G_RENKO, tooltip="Fixed Renko brick size in this instrument\'s PRICE units. 8.33 means 8.33 index points or currency units, NOT 8.33%.")
float percentSize = input.float(0.50, "Brick as % of close", minval=0.01, step=0.05, group=G_RENKO)
int maxPerBar = input.int(80, "Maximum bricks from one candle", minval=1, maxval=150, group=G_RENKO, tooltip="Safety limit for a large move within one completed chart candle. If reached, the move may not be fully represented.")
bool showST = input.bool(true, "Show Renko SuperTrend", group=G_TREND)
int stLength = input.int(10, "SuperTrend ATR length (Renko bricks)", minval=1, group=G_TREND)
float stFactor = input.float(3.0, "SuperTrend factor", minval=0.10, step=0.10, group=G_TREND)
bool showBoxes = input.bool(true, "Show time-aligned Renko bricks", group=G_VIEW)
bool hideCandles = input.bool(false, "Make ordinary candles transparent", group=G_VIEW)
int maxVisible = input.int(400, "Maximum visible brick boxes", minval=20, maxval=450, group=G_VIEW)
int transparency = input.int(0, "Brick transparency", minval=0, maxval=90, group=G_VIEW)
color upColor = input.color(color.rgb(38, 166, 154), "Up brick / bullish SuperTrend", group=G_VIEW)
color downColor = input.color(color.rgb(239, 83, 80), "Down brick / bearish SuperTrend", group=G_VIEW)
bool showFlips = input.bool(false, "Show SuperTrend flip markers", group=G_VIEW)
bool showPanel = input.bool(true, "Show compact status panel", group=G_INFO)

// TradingView reruns the indicator when the visible range changes.
// Calculations process ALL loaded confirmed bars, but boxes are drawn only
// inside the visible window. This prevents future-looking historical bricks.
int leftVisibleTime = chart.left_visible_bar_time
int rightVisibleTime = chart.right_visible_bar_time
float sourceAtr = ta.atr(atrPeriod)
float wanted = sizeMode == "Traditional" ? fixedSize : sizeMode == "Percentage" ? close * percentSize / 100.0 : sourceAtr * atrFactor
float brickSize = not na(wanted) and wanted > 0 ? math.max(syminfo.mintick, math.round(wanted / syminfo.mintick) * syminfo.mintick) : na

// State of the confirmed close-based Renko bricks.
var float renkoClose = na
var int renkoDirection = 0
var int totalBricks = 0
var int maxBarOverflow = 0
var array<box> drawn = array.new<box>()

// Independent Wilder ATR and trailing SuperTrend bands, updated per
// COMPLETED SYNTHETIC BRICK, not once per ordinary chart candle.
var float renkoAtr = na
var float upperBand = na
var float lowerBand = na
var float trailingLine = na
var int trendDirection = 0

bool bullishFlip = false
bool bearishFlip = false
if barstate.isconfirmed and not na(close)
    if na(renkoClose)
        renkoClose := math.round(close / syminfo.mintick) * syminfo.mintick
    else if not na(brickSize)
        int formed = 0
        while formed < maxPerBar
            bool rising = close >= renkoClose + brickSize * (renkoDirection == -1 ? 2.0 : 1.0)
            bool falling = close <= renkoClose - brickSize * (renkoDirection == 1 ? 2.0 : 1.0)
            if not rising and not falling
                break

            float previousBrickClose = renkoClose
            float brickOpen = rising ? renkoClose + (renkoDirection == -1 ? brickSize : 0.0) : renkoClose - (renkoDirection == 1 ? brickSize : 0.0)
            float brickClose = brickOpen + (rising ? brickSize : -brickSize)
            brickOpen := math.round(brickOpen / syminfo.mintick) * syminfo.mintick
            brickClose := math.round(brickClose / syminfo.mintick) * syminfo.mintick
            float brickHigh = math.max(brickOpen, brickClose)
            float brickLow = math.min(brickOpen, brickClose)

            renkoClose := brickClose
            renkoDirection := rising ? 1 : -1
            totalBricks += 1
            formed += 1

            // True range includes the gap created by a classic 2-box reversal.
            float tr = math.max(brickHigh - brickLow, math.max(math.abs(brickHigh - previousBrickClose), math.abs(brickLow - previousBrickClose)))
            renkoAtr := na(renkoAtr) ? tr : (renkoAtr * (stLength - 1) + tr) / stLength

            float basicUpper = (brickHigh + brickLow) / 2.0 + stFactor * renkoAtr
            float basicLower = (brickHigh + brickLow) / 2.0 - stFactor * renkoAtr
            float priorUpper = upperBand
            float priorLower = lowerBand
            upperBand := na(priorUpper) or basicUpper < priorUpper or previousBrickClose > priorUpper ? basicUpper : priorUpper
            lowerBand := na(priorLower) or basicLower > priorLower or previousBrickClose < priorLower ? basicLower : priorLower

            int wasDirection = trendDirection
            trendDirection := wasDirection == 0 ? renkoDirection : wasDirection == 1 ? (brickClose < lowerBand ? -1 : 1) : (brickClose > upperBand ? 1 : -1)
            trailingLine := trendDirection == 1 ? lowerBand : upperBand
            bullishFlip := bullishFlip or (wasDirection == -1 and trendDirection == 1)
            bearishFlip := bearishFlip or (wasDirection == 1 and trendDirection == -1)

            // Each brick gets the source candle's X coordinate; multiple bricks
            // from one candle stack vertically, never backdate into earlier bars.
            if showBoxes and time >= leftVisibleTime and time <= rightVisibleTime
                color brickColor = rising ? upColor : downColor
                box bx = box.new(left=bar_index, top=brickHigh, right=bar_index + 1, bottom=brickLow, xloc=xloc.bar_index, border_color=brickColor, border_width=1, bgcolor=color.new(brickColor, transparency))
                array.push(drawn, bx)
                if array.size(drawn) > maxVisible
                    box.delete(array.shift(drawn))

        if formed == maxPerBar
            bool stillUp = close >= renkoClose + brickSize * (renkoDirection == -1 ? 2.0 : 1.0)
            bool stillDown = close <= renkoClose - brickSize * (renkoDirection == 1 ? 2.0 : 1.0)
            if stillUp or stillDown
                maxBarOverflow += 1

barcolor(hideCandles ? color.new(color.gray, 100) : na)
plot(showST and trendDirection == 1 ? trailingLine : na, "Bullish Renko SuperTrend", color=upColor, linewidth=2, style=plot.style_linebr)
plot(showST and trendDirection == -1 ? trailingLine : na, "Bearish Renko SuperTrend", color=downColor, linewidth=2, style=plot.style_linebr)
plotshape(showFlips and bullishFlip, title="SuperTrend bullish flip", text="UP", style=shape.labelup, location=location.belowbar, color=upColor, textcolor=color.white, size=size.tiny)
plotshape(showFlips and bearishFlip, title="SuperTrend bearish flip", text="DN", style=shape.labeldown, location=location.abovebar, color=downColor, textcolor=color.white, size=size.tiny)
alertcondition(bullishFlip, "ASJR Renko ST bullish flip", "ASJR Renko SuperTrend bullish flip (confirmed chart candle)")
alertcondition(bearishFlip, "ASJR Renko ST bearish flip", "ASJR Renko SuperTrend bearish flip (confirmed chart candle)")
plot(brickSize, "Source brick size", display=display.data_window)
plot(renkoClose, "Completed Renko close", display=display.data_window)

var table panel = table.new(position.top_right, 2, 3, border_width=1)
if barstate.islast
    if showPanel
        table.cell(panel, 0, 0, "ASJR RENKO ST", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(panel, 1, 0, "v1", bgcolor=color.new(color.black, 15), text_color=color.white)
        table.cell(panel, 0, 1, "Brick / trend", text_color=color.white, bgcolor=color.new(color.black, 30))
        table.cell(panel, 1, 1, str.tostring(brickSize, format.mintick) + " / " + (trendDirection == 1 ? "UP" : trendDirection == -1 ? "DOWN" : "WAIT"), text_color=trendDirection == 1 ? upColor : trendDirection == -1 ? downColor : color.silver, bgcolor=color.new(color.black, 30))
        table.cell(panel, 0, 2, "Bricks / capped bars", text_color=color.white, bgcolor=color.new(color.black, 30))
        table.cell(panel, 1, 2, str.tostring(totalBricks) + " / " + str.tostring(maxBarOverflow), text_color=color.white, bgcolor=color.new(color.black, 30))
    else
        table.clear(panel, 0, 0, 1, 2)
